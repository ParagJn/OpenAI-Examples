<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI"
             targetNamespace="http://example.bpmn"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL BPMN20.xsd">

  <process id="materialScrappingProcess" name="Material Scrapping Process">
    <startEvent id="startEvent1" name="Start Material Scrapping Process"/>
    <sequenceFlow id="flow1" sourceRef="startEvent1" targetRef="taskMaterialHandling"/>

    <task id="taskMaterialHandling" name="Material Handling"/>
    <sequenceFlow id="flow2" sourceRef="taskMaterialHandling" targetRef="taskDecisionPoints"/>

    <task id="taskDecisionPoints" name="Decision Points"/>
    <sequenceFlow id="flow3" sourceRef="taskDecisionPoints" targetRef="taskStockMovement"/>

    <task id="taskStockMovement" name="Stock Movement"/>
    <sequenceFlow id="flow4" sourceRef="taskStockMovement" targetRef="taskScrappingAndWaste"/>

    <task id="taskScrappingAndWaste" name="Scrapping and Waste"/>
    <sequenceFlow id="flow5" sourceRef="taskScrappingAndWaste" targetRef="endEvent1"/>
    
    <endEvent id="endEvent1" name="End Material Scrapping Process"/>
  </process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_MaterialScrapping">
    <bpmndi:BPMNPlane id="BPMNPlane_MaterialScrapping" bpmnElement="materialScrappingProcess">
      <bpmndi:BPMNShape id="shape_startEvent1" bpmnElement="startEvent1">
        <omgdc:Bounds x="100" y="160" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="edge_flow1" bpmnElement="flow1">
        <omgdi:waypoint x="136" y="178"/>
        <omgdi:waypoint x="220" y="178"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNShape id="shape_taskMaterialHandling" bpmnElement="taskMaterialHandling">
        <omgdc:Bounds x="220" y="158" width="100" height="40"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="edge_flow2" bpmnElement="flow2">
        <omgdi:waypoint x="320" y="178"/>
        <omgdi:waypoint x="400" y="178"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNShape id="shape_taskDecisionPoints" bpmnElement="taskDecisionPoints">
        <omgdc:Bounds x="400" y="158" width="100" height="40"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="edge_flow3" bpmnElement="flow3">
        <omgdi:waypoint x="500" y="178"/>
        <omgdi:waypoint x="580" y="178"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNShape id="shape_taskStockMovement" bpmnElement="taskStockMovement">
        <omgdc:Bounds x="580" y="158" width="100" height="40"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="edge_flow4" bpmnElement="flow4">
        <omgdi:waypoint x="680" y="178"/>
        <omgdi:waypoint x="760" y="178"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNShape id="shape_taskScrappingAndWaste" bpmnElement="taskScrappingAndWaste">
        <omgdc:Bounds x="760" y="158" width="100" height="40"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="edge_flow5" bpmnElement="flow5">
        <omgdi:waypoint x="860" y="178"/>
        <omgdi:waypoint x="940" y="178"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNShape id="shape_endEvent1" bpmnElement="endEvent1">
        <omgdc:Bounds x="940" y="160" width="36" height="36"/>
      </bpmndi:BPMNShape>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</definitions>